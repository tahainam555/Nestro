# Environment variables for orchestrator

# LLM Configuration - Use ANY ONE of these:
# Option 1: OpenAI
OPENAI_API_KEY=

# Option 2: Groq (recommended - free, fast)
GROQ_API_KEY=

# Option 3: Anthropic
ANTHROPIC_API_KEY=

# Backend API Configuration
BACKEND_BASE_URL=http://localhost:8000


# Optional: Override individual API endpoints
# VISION_API_ENDPOINT=http://localhost:8000/api/vision/analyze
# STYLE_API_ENDPOINT=http://localhost:8000/api/styles/search
# PRODUCT_API_ENDPOINT=http://localhost:8000/api/products/search
